{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/business/:id",
      "destination": "/api"
    },
    {
      "source": "/generate-review",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/api/:match*",
      "destination": "/api"
    }
  ]
}
